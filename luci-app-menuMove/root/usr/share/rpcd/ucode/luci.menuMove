'use strict';

/*
 * rpcd ucode plugin providing the "menu_move" ubus object.
 *
 *   ubus call menu_move status
 *   ubus call menu_move apply
 *
 * The heavy lifting lives in /usr/share/ucode/luci/menuMove.uc, which is
 * shared with the /usr/bin/menu-move CLI tool.
 */

import { status, apply } from 'luci.menuMove';

return {
	menu_move: {
		status: {
			call: function() {
				return status();
			}
		},

		apply: {
			call: function() {
				return apply();
			}
		}
	}
};
